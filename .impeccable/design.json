  "narrative": {
    "northStar": "The evening edit",
    "overview": "Genuine artwork carries the atmosphere; precise alignment, readable type and clear remote focus carry the interface. Cool ink surfaces and warm sand feedback suit a television viewed from the sofa. The native Android TV implementation is the current release surface; the shared Vega target remains a separate platform.\n\nControl shapes express their role: rectangular text actions, circular icon actions, square artwork and spacious sheet choices. Browsing, search, title details, settings and playback each have a composition suited to their task. Genre selection uses a dedicated sheet; playback has centered transport and a separate utility hierarchy.",
    "keyCharacteristics": [
      "Genuine cinematic photography with integrated legibility masks.",
      "Quiet ink surfaces, ivory text and sand focus.",
      "Role-specific controls and distinct screen compositions.",
      "Predictable D-pad navigation, native sheets and restored focus.",
      "Honest sample-catalog and simulated-preview states."
    ],
    "rules": [
      {
        "name": "Focus First",
        "body": "Reinforce focus with shape or a visible frame as well as color. Shared buttons use sand fill, ink content and an ivory frame; artwork uses an ivory frame and modest scale. Header text destinations use an ivory focus field with a sand border. Persistent selection uses an underline, check or radio marker and remains distinct from temporary focus.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve artwork ratios, safe margins and visible remote focus.",
      "Do distinguish selection from focus with checks, radio markers or underlines.",
      "Do use circular controls for icon actions and rounded rectangles for text actions.",
      "Do center transport controls and align title copy, timelines and utility groups deliberately.",
      "Do keep errors actionable and sample mode distinguishable.",
      "Do inspect native TV captures and remote behavior before claiming a layout is verified."
    ],
    "donts": [
      "Don't expand genre choices into a permanent wall of filter buttons.",
      "Don't invent catalog information, ratings, source availability or licensing claims.",
      "Don't replace real playback failure with an unlabeled simulated clock.",
      "Don't add decorative glass, glow or slow navigation choreography.",
      "Don't request focus for a hidden scope or remove a focused page-loading control."
    ]
  }
