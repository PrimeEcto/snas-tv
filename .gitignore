node_modules/
build/
dist/

# Gradle's and Kotlin's own state inside the Fire TV project. The wrapper, the sources and the
# checked-in Gradle files are what a build needs; caches and session files are not.
.gradle/
.kotlin/
.cxx/
local.properties
research/automation*/
research/*.html
research/*.ppm

# Screenshots from the device-journey harnesses: the dump, the JSON result and the logcat
# extract next to them are the evidence that gets committed, and they are reproducible.
research/android/*.png

# ESLint plugin scratch state written by the Kepler lint plugin at runtime.
generated/
src/config.local.json
.env*
!.env.example

# The account owner's plaintext TMDB credential, attached outside version control.
TMDBAPI

# Supabase CLI project link (a project ref, not a secret, but generated).
supabase/.temp/

# Cloudflare credentials supplied by the account owner; never committed.
CloudflareCredentials/

# Worker-local state and secrets
worker/node_modules/
worker/.wrangler/
worker/.dev.vars
worker/test/fixtures/live-*.json
!worker/.dev.vars.example
.codebase-memory/
.aider*

# Freebuff agent runtime state (project id, caches).
.freebuff/

# Large local research artifacts: virtual-device disk images, guest journals and
# shared libraries captured while testing. Evidence stays in text form; these do not
# belong in a repository (and one disk image was over GitHub's 100 MB limit).
research/vvd-data-backup/
research/*-journal/
research/*.qcow2*
research/*.so
research/*.so.*

# Emulator bookkeeping written by scripts/android-device-start.sh while the harness runs.
research/*.pid

# Native audit screenshots stay local; text evidence and release checks are tracked.
research/v003/**/*.png
research/v003/*.png
