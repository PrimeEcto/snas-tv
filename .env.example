# SNAS deployment secrets. Copy to .env (git-ignored) and fill it in — this file is the
# single source of truth for the Supabase function environment and the Cloudflare Worker.
#
#   supabase secrets set --env-file .env     # pushes TMDB_API_KEY and RELAY_SECRET
#   npm run functions:deploy                 # deploy both edge functions
#
# Nothing in this file is ever committed, and no credential here reaches the Fire TV app.

# TMDB credential, server-side only. Either a v3 API key (32 hex characters) or a v4
# read access token. The app calls the `tmdb` function and never holds a key itself.
TMDB_API_KEY=
# TMDB_READ_TOKEN=

# Shared secret for the `movy-relay` function, which performs upstream HTTP fetches from a
# non-Cloudflare egress (Cloudflare's shared IPs are rate-limited with HTTP 429 upstream).
RELAY_SECRET=

# Project coordinates and the PostgREST key used by the Worker's durable cache.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Database password, read only by the Supabase CLI when it applies the migrations in
# supabase/migrations (`supabase db push --linked`, which needs a linked project). It never
# reaches the Worker, the edge functions or the app. Quote the value if it contains `$` or
# other shell metacharacters: `set -a; . .env` expands them and the CLI then authenticates
# with a mangled password ("password authentication failed for user \"postgres\"").
SUPABASE_DB_PASSWORD=
