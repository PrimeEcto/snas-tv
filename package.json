{
  "name": "@amazon-devices/snas",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "start": "react-native start",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:snapshot": "jest --colors --updateSnapshot",
    "lint": "eslint src tests package.json --ext .ts,.tsx",
    "lint:fix": "eslint src tests package.json --ext .ts,.tsx --fix",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build:app": "npm-run-all build:release",
    "build": "npm-run-all build:release",
    "release": "npm-run-all lint test build:app",
    "typecheck": "tsc --noEmit",
    "secrets:push": "supabase secrets set --env-file .env",
    "functions:deploy": "supabase functions deploy tmdb --no-verify-jwt --use-api && supabase functions deploy movy-relay --no-verify-jwt --use-api",
    "release:app": "node scripts/release-app.mjs",
    "device:update": "node scripts/device-watch.mjs",
    "device:update:once": "node scripts/device-watch.mjs --once",
    "worker:dev": "npm --prefix worker run dev",
    "worker:deploy": "npm --prefix worker run deploy",
    "worker:typecheck": "npm --prefix worker run typecheck",
    "worker:test": "npm --prefix worker test",
    "worker:smoke": "npm --prefix worker run smoke",
    "device:start": "bash scripts/device-start.sh",
    "device:stop": "bash scripts/device-stop.sh",
    "build:tv": "bash scripts/build.sh"
  },
  "dependencies": {
    "@amazon-devices/react-linear-gradient": "~2.0.9000000001",
    "@amazon-devices/react-native-kepler": "~4.0.0",
    "@react-native-async-storage/async-storage": "npm:@amazon-devices/react-native-async-storage__async-storage@~2.1.0",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-svg": "npm:@amazon-devices/react-native-svg@~3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@amazon-devices/eslint-plugin-kepler": "^0.1.4",
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "20.0.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@react-native/metro-config": "0.83.0",
    "@react-native/typescript-config": "0.83.0",
    "@testing-library/react-native": "^13.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jest": "^27.6.0",
    "jest": "^29.7.0",
    "jsonc-eslint-parser": "^2.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.8.8",
    "react-test-renderer": "19.2.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.15",
    "typescript": "5.8.3"
  },
  "kepler": {
    "projectType": "application",
    "appName": "SNAS",
    "targets": [
      "tv"
    ]
  },
  "overrides": {
    "react-native-svg": "npm:@amazon-devices/react-native-svg@~3.0.0",
    "@react-native-async-storage/async-storage": "npm:@amazon-devices/react-native-async-storage__async-storage@~2.1.0"
  }
}
